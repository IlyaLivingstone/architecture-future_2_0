# Terraform: кэш провайдеров и локальное состояние
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# lock-файл не коммитим: он фиксирует только платформу локального init,
# а CI ставит Terraform на linux и сгенерирует свой
**/.terraform.lock.hcl

override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# зеркало провайдеров, если реестр HashiCorp недоступен
.terraform-mirror/

# секреты и локальные значения
.env
*.pem
*.key
**/terraform.tfvars
**/backend.hcl

# ОС и IDE
.DS_Store
.idea/
.vscode/
