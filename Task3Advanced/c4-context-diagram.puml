@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.5.0/C4_Context.puml

title Контекст «Будущее 2.0» — целевое состояние, горизонт три года

Person(doctor, "Врач", "Ведёт приём, работает с медкартами и результатами исследований")
Person(clinic_operator, "Оператор клиники", "Регистрирует пациентов, оформляет услуги")
Person(analyst, "Аналитик и бизнес-пользователь", "Собирает отчёты в портале самообслуживания")
Person(fintech_client, "Клиент финтеха", "Пользуется счетами, платежами и кредитами")

System(future20, "Будущее 2.0", "Клиники, финтех, ИИ-сервисы, головной офис, аналитическая платформа")

System_Ext(legacy, "Легаси-ландшафт", "DWH на SQL Server 2008, PowerBuilder, Power BI, шина Camel — выводятся из эксплуатации к 36 месяцу")
System_Ext(partners, "Фарма и производитель медоборудования", "Подключаются как партнёры по контрактам событий")
System_Ext(new_sources, "Новые источники данных", "Медоборудование, IoT-устройства, региональные фиды")
System_Ext(regulators, "Регуляторы", "Получают отчётность по медданным и банковским операциям")

Rel(doctor, future20, "Смотрит медкарты и результаты исследований", "HTTPS")
Rel(clinic_operator, future20, "Регистрирует визиты и услуги", "HTTPS")
Rel(analyst, future20, "Строит отчёты и срезы", "HTTPS")
Rel(fintech_client, future20, "Платит и оформляет кредиты", "HTTPS")

Rel(future20, partners, "Обмен событиями и заявками", "Контракты событий / REST")
Rel(new_sources, future20, "Отдаёт поток данных", "Kafka / API")
Rel(future20, regulators, "Регуляторная отчётность", "Выгрузки")

Rel(future20, legacy, "Читает исторические данные на время миграции", "CDC")
Rel(legacy, future20, "Отдаёт изменения и вызовы", "CDC / адаптеры")

@enduml
